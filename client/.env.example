# Frontend Environment Variables
# Leave VITE_API_URL empty in development to utilize the Vite dev proxy (/api and /socket.io)
VITE_API_URL=

# Map Provider (OpenStreetMap default)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Razorpay Test Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
