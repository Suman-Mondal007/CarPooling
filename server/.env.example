# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/carpooling

# Authentication Secrets (minimum 16 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_characters_here

# Cookies
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Geocoding & Routing Services
GEOCODING_URL=https://nominatim.openstreetmap.org
MAP_ROUTING_URL=https://router.project-osrm.org
GEO_USER_AGENT=CarpoolingPlatform/1.0 (contact@carpooling.local)

# Payments (Razorpay Sandbox/Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ALLOW_SIMULATED_PAYMENTS=true

# SMTP Mailer (Optional in dev - links logged to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@carpooling.local

# Default Seed Credentials
SEED_ADMIN_EMAIL=admin@enterprise.local
SEED_ADMIN_PASSWORD=Admin@Pass123
